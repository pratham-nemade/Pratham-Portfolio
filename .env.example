# Public URL of the site (canonical links, Open Graph, sitemap).
# Optional on Vercel, which provides the production URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery through EmailJS (optional overrides; the defaults
# in src/config/site.ts are used when these are not set).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
